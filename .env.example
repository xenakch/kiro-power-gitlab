# Copy this file to .env and fill in your real token.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# The .env file is git-ignored and must never be committed.
#
# Create a GitLab personal access token here:
#   https://gitlab.com/-/user_settings/personal_access_tokens
#
# Scope: read_api  (read-only is sufficient for this Power — do NOT grant full "api")
# Set an expiration date (e.g. 30-90 days).
#
# After filling in the token below, launch Kiro so it inherits the token:
#   ./start.sh                                   (macOS/Linux)
#   # Windows PowerShell (no wrapper): load .env, then start Kiro
#   Get-Content .env | Where-Object { $_ -match '=' } | ForEach-Object {
#     $k,$v = $_ -split '=',2; Set-Item "Env:$k" $v }; kiro-cli chat

GITLAB_PERSONAL_ACCESS_TOKEN=
