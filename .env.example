# Copy this file to .env and fill in your real token.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# The .env file is git-ignored and must never be committed.
#
# Create a GitLab personal access token here:
#   https://gitlab.com/-/user_settings/personal_access_tokens
#
# Scope: read_api  (read-only is sufficient for this Power — do NOT grant full "api")
# Set an expiration date (e.g. 30-90 days).

GITLAB_PERSONAL_ACCESS_TOKEN=
